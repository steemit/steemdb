# Binaries (compiled executables)
*.exe
*.exe~
*.dll
*.so
*.dylib
# Note: Do not ignore cmd/ directories, only compiled binaries

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Config files with secrets
configs/*.local.yaml
configs/*.secret.yaml
