{
  "dashboard": {
    "id": null,
    "title": "SteemDB Sync Service",
    "tags": ["steemdb", "blockchain", "sync"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Block Processing Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(steemdb_blocks_processed_total[5m])",
            "legendFormat": "Blocks/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Operation Processing Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(steemdb_operations_processed_total[5m])",
            "legendFormat": "Ops/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Current Block Height",
        "type": "stat",
        "targets": [
          {
            "expr": "steemdb_current_block",
            "legendFormat": "Block Height"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(steemdb_errors_total[5m])",
            "legendFormat": "Errors/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.1},
                {"color": "red", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}
      },
      {
        "id": 5,
        "title": "Queue Sizes",
        "type": "stat",
        "targets": [
          {
            "expr": "steemdb_queue_size",
            "legendFormat": "{{queue_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}
      },
      {
        "id": 6,
        "title": "Processing Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(steemdb_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(steemdb_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile"
          }
        ],
        "yAxes": [
          {
            "unit": "s"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
      },
      {
        "id": 7,
        "title": "Operations by Type",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(steemdb_operations_processed_total[5m])",
            "legendFormat": "{{operation_type}}"
          }
        ],
        "yAxes": [
          {
            "unit": "ops"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
      },
      {
        "id": 8,
        "title": "Database Operations",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(steemdb_database_operations_total[5m])",
            "legendFormat": "{{operation}} - {{collection}}"
          }
        ],
        "yAxes": [
          {
            "unit": "ops"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
      },
      {
        "id": 9,
        "title": "Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "steemdb_memory_usage_bytes",
            "legendFormat": "{{type}}"
          }
        ],
        "yAxes": [
          {
            "unit": "bytes"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}
      },
      {
        "id": 10,
        "title": "RPC Requests",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(steemdb_rpc_requests_total[5m])",
            "legendFormat": "{{method}} - {{status}}"
          }
        ],
        "yAxes": [
          {
            "unit": "ops"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  }
}
