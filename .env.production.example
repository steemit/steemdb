# Environment for docker-compose.production.yml.
# Copy to .env and adjust:  cp .env.production.example .env

# --- Required ---------------------------------------------------------------

# Grafana admin password. The production compose refuses to start while this
# is unset (no baked-in default on purpose).
GRAFANA_ADMIN_PASSWORD=

# --- Steem RPC ---------------------------------------------------------------

# RPC endpoint used by processor / live-sync / steemdb-refresher.
RPC_ENDPOINT=https://api.steemit.com

# --- MongoDB ------------------------------------------------------------------
# Default: no auth, reachable only inside the compose network (mongo is not
# published to the host). If you enable mongo auth, put the credentials in
# BOTH URIs and keep the database name in MONGO_URI (the sync side takes the
# database from the URI when MONGO_DATABASE is unset):
#   MONGO_URI=mongodb://user:pass@mongo:27017/steemdb?authSource=admin
MONGO_URI=mongodb://mongo:27017/steemdb
# Web reads the database name from its mounted config
# (steemdb-web/configs/config.yaml), so the URI needs no database component.
WEB_MONGODB_URI=mongodb://mongo:27017/

# --- Web ----------------------------------------------------------------------

# Host port for the public web service (Nginx + API + SPA).
WEB_PORT=80

# --- Optional -------------------------------------------------------------------

LOG_LEVEL=info
PROMETHEUS_RETENTION=200h
